<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/bg_color">

    <TextView
        android:id="@+id/tide_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tide_import_checking"
        android:textAppearance="?attr/textAppearanceSubtitle2"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/tide_import_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Import Harmonic File (XTide)"
        app:icon="@drawable/ic_action_import"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/tide_progress_bar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available Stations (Signal K)"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="?attr/colorAccent"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
