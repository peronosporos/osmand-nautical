<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_side_widget_day"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/wind_trend_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_action_wind"
        app:tint="#FFFF00"
        android:contentDescription="Wind Trend" />

    <TextView
        android:id="@+id/wind_trend_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="WIND TREND (30m)"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wind_shift_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--°"
        android:textColor="#00FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp"/>

</LinearLayout>
