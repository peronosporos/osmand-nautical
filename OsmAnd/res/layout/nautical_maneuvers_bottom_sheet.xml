<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/list_background_color"
    android:orientation="vertical"
    android:padding="16dp">

    <View
        android:id="@+id/drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="12dp"
        android:background="?attr/divider_color" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nautical_maneuver_menu"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp"
        android:textColor="?android:attr/textColorPrimary"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/maneuvers_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nautical_maneuver_params"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:textColor="?android:attr/textColorPrimary"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/label_vessel_length"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/nautical_med_mooring_vessel_length"
            android:textColor="?android:attr/textColorSecondary"/>
        <ImageButton
            android:id="@+id/btn_length_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_action_remove"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nautical_accessibility_minus"/>
        <TextView
            android:id="@+id/txt_vessel_length"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"/>
        <ImageButton
            android:id="@+id/btn_length_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_action_plus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nautical_accessibility_plus"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">
        <TextView
            android:id="@+id/label_anchor_scope"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/nautical_anchor_scope_label"
            android:textColor="?android:attr/textColorSecondary"/>
        <ImageButton
            android:id="@+id/btn_scope_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_action_remove"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nautical_accessibility_minus"/>
        <TextView
            android:id="@+id/txt_anchor_scope"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"/>
        <ImageButton
            android:id="@+id/btn_scope_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_action_plus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nautical_accessibility_plus"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/nautical_anchor_depth_label"
            android:textColor="?android:attr/textColorSecondary"/>
        <ImageButton
            android:id="@+id/btn_depth_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_action_remove"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nautical_accessibility_minus"/>
        <TextView
            android:id="@+id/txt_anchor_depth"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"/>
        <ImageButton
            android:id="@+id/btn_depth_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_action_plus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nautical_accessibility_plus"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/nautical_anchor_tide_label"
            android:textColor="?android:attr/textColorSecondary"/>
        <ImageButton
            android:id="@+id/btn_tide_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_action_remove"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nautical_accessibility_minus"/>
        <TextView
            android:id="@+id/txt_anchor_tide"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"/>
        <ImageButton
            android:id="@+id/btn_tide_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_action_plus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nautical_accessibility_plus"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_bow_offset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/nautical_anchor_label_bow_offset"
            android:textColor="?android:attr/textColorSecondary"/>
        <ImageButton
            android:id="@+id/btn_bow_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_action_remove"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nautical_accessibility_minus"/>
        <TextView
            android:id="@+id/txt_bow_offset"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"/>
        <ImageButton
            android:id="@+id/btn_bow_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_action_plus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nautical_accessibility_plus"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txt_calculated_rode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:gravity="center"
        android:textColor="?attr/colorAccent"
        android:textStyle="italic"
        android:text="@string/nautical_calculated_rode"/>

    <TextView
        android:id="@+id/txt_maneuver_instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:gravity="center"
        android:textColor="?android:attr/textColorPrimary"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btn_execute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/maneuver_execute"
        android:visibility="gone"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="?android:attr/dividerVertical" />

    <Button
        android:id="@+id/btn_passage_plan"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nautical_view_passage_plan" />

</LinearLayout>
