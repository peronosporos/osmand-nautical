<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pilot_glass"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pilot_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/bottom_sheet_handle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_handle"
            android:backgroundTint="#99FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/shared_string_options" />

        <!-- 1. Dashboard Header (Mode Toggles) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/mode_toggle_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toStartOf="@id/btn_mode_stop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bottom_sheet_handle"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_compass"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@drawable/ic_action_direction_compass"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="?attr/icon_color_primary"
                app:strokeColor="@color/nautical_toggle_stroke_color"
                app:backgroundTint="@color/nautical_toggle_bg_tint"
                android:contentDescription="@string/nautical_mode_compass" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_wind"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@drawable/ic_action_wind"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="?attr/icon_color_primary"
                app:strokeColor="@color/nautical_toggle_stroke_color"
                app:backgroundTint="@color/nautical_toggle_bg_tint"
                android:contentDescription="@string/nautical_mode_wind" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_route"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@drawable/ic_action_track_16"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="?attr/icon_color_primary"
                app:strokeColor="@color/nautical_toggle_stroke_color"
                app:backgroundTint="@color/nautical_toggle_bg_tint"
                android:contentDescription="@string/nautical_mode_track" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_stop"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:icon="@drawable/ic_action_stop"
            app:iconGravity="textStart"
            app:iconSize="24dp"
            app:iconTint="@color/nautical_status_text_emergency"
            app:strokeColor="@color/nautical_status_text_emergency"
            app:backgroundTint="@color/nautical_status_bg_emergency"
            app:layout_constraintBottom_toBottomOf="@id/mode_toggle_group"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/mode_toggle_group"
            android:contentDescription="@string/nautical_mode_stop" />

        <TextView
            android:id="@+id/auth_warning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:text="@string/nautical_auth_token_required"
            android:textColor="@color/nautical_status_text_emergency"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_nautical_status_emergency"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingVertical="4dp"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mode_toggle_group"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/header_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/auth_warning">

            <ImageButton
                android:id="@+id/btn_maneuvers"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nautical_maneuver_menu"
                app:srcCompat="@drawable/ic_action_sail_boat_dark"
                app:tint="?attr/icon_color_primary" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#33FFFFFF" />

            <ImageButton
                android:id="@+id/btn_switches"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nautical_switches_label"
                app:srcCompat="@drawable/ic_action_nautical_battery_volt"
                app:tint="?attr/icon_color_primary" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#33FFFFFF" />

            <ImageButton
                android:id="@+id/btn_systems"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nautical_systems_group"
                app:srcCompat="@drawable/ic_action_layers"
                app:tint="?attr/icon_color_primary" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#33FFFFFF" />

            <ImageButton
                android:id="@+id/btn_advanced"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/shared_string_settings"
                app:srcCompat="@drawable/ic_action_settings"
                app:tint="?attr/icon_color_primary" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#33FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lock_unlock"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                app:icon="@drawable/ic_action_lock"
                app:iconTint="?attr/icon_color_primary"
                android:contentDescription="@string/nautical_lock_course" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#33FFFFFF" />

            <ImageButton
                android:id="@+id/btn_tool_center"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nautical_tool_center"
                app:srcCompat="@drawable/ic_action_additional_option"
                app:tint="?attr/icon_color_primary" />
        </LinearLayout>

        <!-- 2. Autopilot Head Card (Steering + Control Cluster) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/steering_card"
            style="@style/Widget.App.Material.SectionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#26FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_actions">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp">

                <!-- Heading Error (Linear Scale) at the TOP -->
                <net.osmand.plus.plugins.nautical.ui.HeadingErrorLinearView
                    android:id="@+id/heading_error_linear"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Control Cluster Middle Row -->
                <net.osmand.plus.plugins.nautical.ui.HeadingArcView
                    android:id="@+id/heading_arc_view"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heading_error_linear"
                    android:contentDescription="@string/nautical_pilot_title"
                    android:focusable="true" />

                <!-- Predictive Steering Active Indicator -->
                <ImageView
                    android:id="@+id/img_predictive_active"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_action_nautical_depth"
                    app:tint="@color/nautical_status_green"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="@string/nautical_predictive_steering_active" />

                <!-- Left Controls (Vertical Column) -->
                <LinearLayout
                    android:id="@+id/left_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/heading_arc_view"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/heading_arc_view">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_minus_10"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="64dp"
                        android:layout_height="56dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="-10"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/active_color_primary"
                        app:strokeColor="?attr/active_color_primary"
                        app:cornerRadius="12dp"
                        android:contentDescription="-10 degrees" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_minus_1"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="-1"
                        android:textColor="?attr/active_color_primary"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="?attr/active_color_primary"
                        android:contentDescription="-1 degree" />
                </LinearLayout>

                <!-- Right Controls (Vertical Column) -->
                <LinearLayout
                    android:id="@+id/right_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/heading_arc_view"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/heading_arc_view">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_plus_10"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="64dp"
                        android:layout_height="56dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="+10"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/active_color_primary"
                        app:strokeColor="?attr/active_color_primary"
                        app:cornerRadius="12dp"
                        android:contentDescription="+10 degrees" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_plus_1"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="+1"
                        android:textColor="?attr/active_color_primary"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="?attr/active_color_primary"
                        android:contentDescription="+1 degree" />
                </LinearLayout>

                <net.osmand.plus.plugins.nautical.ui.RudderView
                    android:id="@+id/rudder_view"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heading_arc_view"
                    android:contentDescription="@string/nautical_rudder_angle"
                    android:focusable="true" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
