<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/list_background_color"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/pilot_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Drag Handle -->
        <View
            android:id="@+id/drag_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/divider_color" />

        <!-- Header: Title, Mode Indicator & Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/txt_pilot_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nautical_pilot_title"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badge_pilot_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/btn_active_light"
                android:backgroundTint="?attr/active_color_primary"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/nautical_pilot_mode_standby"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_settings_gear"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_settings"
                app:tint="?attr/icon_color_primary"
                android:contentDescription="@string/shared_string_settings" />
        </LinearLayout>

        <!-- 1. Mode Switcher Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/mode_toggle_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_stop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    app:icon="@drawable/ic_action_stop"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="?attr/active_color_primary"
                    app:strokeColor="?attr/active_color_primary"
                    app:strokeWidth="1.5dp"
                    android:contentDescription="@string/nautical_mode_stop" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_compass"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    app:icon="@drawable/ic_action_direction_compass"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="?attr/icon_color_primary"
                    app:strokeColor="?attr/active_color_primary"
                    android:contentDescription="@string/nautical_mode_compass" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_wind"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="AWA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:strokeColor="?attr/active_color_primary"
                    android:contentDescription="@string/nautical_mode_wind" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_twa"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="TWA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:strokeColor="?attr/active_color_primary"
                    android:contentDescription="TWA Hold Mode" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_route"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    app:icon="@drawable/ic_action_track_16"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="?attr/icon_color_primary"
                    app:strokeColor="?attr/active_color_primary"
                    android:contentDescription="@string/nautical_mode_track" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- 2. Main Steering HUD Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/steering_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/card_and_list_background_basic">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <!-- Heading / Wind Error Linear Scale -->
                <net.osmand.plus.plugins.nautical.ui.HeadingErrorLinearView
                    android:id="@+id/heading_error_linear"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Control Cluster Middle Row (Step Buttons + HeadingArcView) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <!-- Port Step Buttons Column: -10° (56dp x 48dp) and -1° (50dp x 42dp) with red tint -->
                    <LinearLayout
                        android:id="@+id/left_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_minus_10"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="56dp"
                            android:layout_height="48dp"
                            android:minHeight="48dp"
                            android:minWidth="56dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="-10°"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#E53935"
                            app:strokeColor="#E53935"
                            app:strokeWidth="2dp"
                            app:cornerRadius="8dp"
                            android:contentDescription="-10 degrees" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_minus_1"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="50dp"
                            android:layout_height="42dp"
                            android:minHeight="42dp"
                            android:minWidth="50dp"
                            android:layout_marginTop="8dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="-1°"
                            android:textColor="#E53935"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:strokeColor="#E53935"
                            app:strokeWidth="1.5dp"
                            android:contentDescription="-1 degree" />
                    </LinearLayout>

                    <!-- Center Heading Arc Wheel (170dp x 170dp) -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center">

                        <net.osmand.plus.plugins.nautical.ui.HeadingArcView
                            android:id="@+id/heading_arc_view"
                            android:layout_width="170dp"
                            android:layout_height="170dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/nautical_pilot_title"
                            android:focusable="true" />

                        <ImageView
                            android:id="@+id/img_predictive_active"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="top|end"
                            android:layout_marginEnd="14dp"
                            android:layout_marginTop="6dp"
                            android:src="@drawable/ic_action_nautical_depth"
                            app:tint="?attr/active_color_primary"
                            android:visibility="gone"
                            android:contentDescription="@string/nautical_predictive_steering_active" />
                    </FrameLayout>

                    <!-- Starboard Step Buttons Column: +10° (56dp x 48dp) and +1° (50dp x 42dp) with green tint -->
                    <LinearLayout
                        android:id="@+id/right_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_plus_10"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="56dp"
                            android:layout_height="48dp"
                            android:minHeight="48dp"
                            android:minWidth="56dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="+10°"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#43A047"
                            app:strokeColor="#43A047"
                            app:strokeWidth="2dp"
                            app:cornerRadius="8dp"
                            android:contentDescription="+10 degrees" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_plus_1"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="50dp"
                            android:layout_height="42dp"
                            android:minHeight="42dp"
                            android:minWidth="50dp"
                            android:layout_marginTop="8dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="+1°"
                            android:textColor="#43A047"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:strokeColor="#43A047"
                            app:strokeWidth="1.5dp"
                            android:contentDescription="+1 degree" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Rudder Angle Bar -->
                <net.osmand.plus.plugins.nautical.ui.RudderView
                    android:id="@+id/rudder_view"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="2dp"
                    android:contentDescription="@string/nautical_rudder_angle"
                    android:focusable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Footer: Tactical Tack Card with SlideToConfirmView -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_tactical_maneuvers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/divider_color"
            app:cardBackgroundColor="?attr/card_and_list_background_basic">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Primary Tack Row (Auto-Tack Port / Lock Guard / Auto-Tack Starboard) -->
                <LinearLayout
                    android:id="@+id/tactical_actions_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Auto-Tack Port -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tack_port"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/nautical_tack_port_short"
                        android:textColor="#E53935"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:strokeColor="#E53935"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="8dp"
                        android:contentDescription="@string/nautical_tack_port" />

                    <!-- Lock Touch Guard Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lock_unlock"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:layout_marginEnd="8dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_action_lock_open"
                        app:iconSize="22dp"
                        app:iconTint="?attr/icon_color_primary"
                        android:contentDescription="@string/nautical_lock_course" />

                    <!-- Auto-Tack Starboard -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tack_stbd"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/nautical_tack_stbd_short"
                        android:textColor="#43A047"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:strokeColor="#43A047"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="8dp"
                        android:contentDescription="@string/nautical_tack_stbd" />
                </LinearLayout>

                <!-- Embedded Confirmation Container (Target Heading & Slide-to-Confirm) -->
                <LinearLayout
                    android:id="@+id/layout_embedded_confirmation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Target Heading Pre-activation Selector Row -->
                    <LinearLayout
                        android:id="@+id/layout_maneuver_target_setup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/txt_maneuver_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tack Port"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary" />

                        <!-- Target Heading Adjusters (-5° / +5°) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_maneuver_deg_minus"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="44dp"
                            android:layout_height="42dp"
                            android:minHeight="42dp"
                            android:minWidth="44dp"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:text="-5°"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/active_color_primary"
                            app:strokeColor="?attr/active_color_primary"
                            app:strokeWidth="1dp"
                            app:cornerRadius="6dp" />

                        <TextView
                            android:id="@+id/txt_maneuver_target_deg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:text="Target: 315°"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/active_color_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_maneuver_deg_plus"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="44dp"
                            android:layout_height="42dp"
                            android:minHeight="42dp"
                            android:minWidth="44dp"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:text="+5°"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/active_color_primary"
                            app:strokeColor="?attr/active_color_primary"
                            app:strokeWidth="1dp"
                            app:cornerRadius="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cancel_embedded_confirmation"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:padding="0dp"
                            app:icon="@drawable/ic_action_cancel"
                            app:iconSize="22dp"
                            app:iconTint="?attr/icon_color_primary"
                            android:contentDescription="@string/shared_string_cancel" />
                    </LinearLayout>

                    <!-- Slide-To-Confirm Bar -->
                    <net.osmand.plus.plugins.nautical.ui.SlideToConfirmView
                        android:id="@+id/embedded_slide_confirm"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Prominent Standby / Disengage Bar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_disengage_standby"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:minHeight="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            app:icon="@drawable/ic_action_stop"
            app:iconSize="22dp"
            app:iconPadding="8dp"
            app:iconTint="@android:color/white"
            android:text="@string/nautical_disengage_standby"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="#D32F2F"
            app:cornerRadius="10dp"
            android:contentDescription="@string/nautical_disengage_standby" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
