<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <net.osmand.plus.plugins.nautical.ui.TacticalHudView
        android:id="@+id/tactical_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <net.osmand.plus.plugins.nautical.ui.HeadingArcView
        android:id="@+id/heading_arc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/mfd_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#808080"
        android:textSize="12sp"
        android:text="@string/nautical_plugin_name" />

</LinearLayout>
