<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="?attr/selectableItemBackground">

    <!-- Drag & Drop Handle (48dp x 48dp touch target) -->
    <ImageView
        android:id="@+id/btn_drag_handle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_action_item_move"
        app:tint="?android:attr/textColorSecondary"
        android:contentDescription="Reorder item drag handle" />

    <!-- Metric Title and Category Badge -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_metric_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"
            android:textSize="15sp"
            tools:text="Speed Over Ground (SOG)" />

        <TextView
            android:id="@+id/txt_metric_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bg_rounded_handle"
            android:backgroundTint="?attr/list_background_color"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            tools:text="Navigation" />
    </LinearLayout>

    <!-- Visibility Eye Toggle (48dp x 48dp touch target) -->
    <ImageView
        android:id="@+id/btn_visibility_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_show_on_map"
        app:tint="?android:attr/textColorPrimary"
        android:contentDescription="@string/shared_string_show" />

    <!-- Delete / Remove Button (48dp x 48dp touch target) -->
    <ImageView
        android:id="@+id/btn_delete_metric"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_action_delete_dark"
        app:tint="?android:attr/textColorSecondary"
        android:contentDescription="@string/shared_string_delete" />

</LinearLayout>
