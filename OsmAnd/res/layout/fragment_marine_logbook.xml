<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/activity_background_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/simple_toolbar" />

        <!-- Expandable Voyage Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_voyage_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/divider_color"
            app:cardBackgroundColor="?attr/card_and_list_background_basic">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Header Row with Expand/Collapse Icon -->
                <LinearLayout
                    android:id="@+id/layout_voyage_summary_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_action_nautical_log"
                        app:tint="?attr/active_color_primary"
                        android:contentDescription="Voyage Log Summary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Voyage Summary"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btn_expand_voyage_summary"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_action_arrow_drop_down"
                        app:tint="?android:attr/textColorSecondary"
                        android:contentDescription="Expand Voyage Summary" />
                </LinearLayout>

                <!-- Expandable 4-metric Grid -->
                <LinearLayout
                    android:id="@+id/layout_voyage_metrics_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <!-- Row 1: Total Distance & Avg SOG -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Total Distance Tile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:padding="8dp"
                            android:orientation="vertical"
                            android:background="?attr/list_background_color">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL DISTANCE"
                                android:textSize="10.5sp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_summary_total_distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0.0 NM"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <!-- Avg SOG Tile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:padding="8dp"
                            android:orientation="vertical"
                            android:background="?attr/list_background_color">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AVG SPEED (SOG)"
                                android:textSize="10.5sp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_summary_avg_sog"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0.0 kn"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 2: Max SOG & Engine / Sail Ratio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <!-- Max SOG Tile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:padding="8dp"
                            android:orientation="vertical"
                            android:background="?attr/list_background_color">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MAX SPEED (SOG)"
                                android:textSize="10.5sp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_summary_max_sog"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0.0 kn"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?attr/active_color_primary" />
                        </LinearLayout>

                        <!-- Engine / Sail Ratio Tile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:padding="8dp"
                            android:orientation="vertical"
                            android:background="?attr/list_background_color">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ENGINE / SAIL RATIO"
                                android:textSize="10.5sp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_summary_engine_sail_ratio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-- / --"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="88dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_action_nautical_log"
                android:alpha="0.3"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/empty_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/logbook_empty"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_entry_fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/logbook_new_entry_title"
        android:src="@drawable/ic_action_add"
        app:fabSize="normal"
        app:backgroundTint="?attr/colorSecondary"
        app:tint="?attr/icon_color_primary" />

</FrameLayout>
