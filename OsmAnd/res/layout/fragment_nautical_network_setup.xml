<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="?attr/activity_background_color">

    <include layout="@layout/simple_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. VENDOR PROFILE PRESETS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1-Tap Vendor Profile Presets"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="?attr/active_color_primary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/divider_color"
                app:cardBackgroundColor="?attr/card_and_list_background_basic">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preset_victron"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="Victron Energy Venus OS (Port 3000)"
                        android:textSize="12sp"
                        android:gravity="start|center_vertical"
                        app:icon="@drawable/ic_action_battery"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preset_yacht_devices"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="Yacht Devices N2K Gateway (UDP/TCP 10110)"
                        android:textSize="12sp"
                        android:gravity="start|center_vertical"
                        app:icon="@drawable/ic_action_settings"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preset_navico"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="B&amp;G / Simrad / Lowrance GoFree (UDP 10110)"
                        android:textSize="12sp"
                        android:gravity="start|center_vertical"
                        app:icon="@drawable/ic_action_sail_boat_dark"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preset_raymarine"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="Raymarine SeaTalkhs / Axiom (Port 2000)"
                        android:textSize="12sp"
                        android:gravity="start|center_vertical"
                        app:icon="@drawable/ic_action_compass" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. ZEROCONF / MDNS SCANNER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Local Network Auto-Discovery (mDNS / ZeroConf)"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="?attr/active_color_primary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/divider_color"
                app:cardBackgroundColor="?attr/card_and_list_background_basic">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_scan_network"
                        style="@style/Widget.Material3.Button.ElevatedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="SCAN LOCAL NETWORK"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_action_search_dark" />

                    <ProgressBar
                        android:id="@+id/progress_scan"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="gone"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/txt_scan_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Tap Scan to discover Signal K and NMEA servers on Wi-Fi"
                        android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                        android:textColor="?android:attr/textColorSecondary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_discovered_servers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. CURRENT CONNECTION STATUS -->
            <TextView
                android:id="@+id/txt_active_connection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Active Target: 192.168.1.100:3000"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
