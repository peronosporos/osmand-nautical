<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/list_background_color"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="@string/nautical_advanced_calibration_dynamics"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/safety_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="@string/nautical_advanced_lock" />
    </RelativeLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/settings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tab 1: Tuning -->
            <LinearLayout
                android:id="@+id/container_tuning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_advanced_rudder_gain" />
                    <TextView
                        android:id="@+id/txt_value_rudder_gain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="1.0" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_rudder_gain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.5"
                    android:valueTo="5.0"
                    android:stepSize="0.1"
                    android:value="1.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_advanced_counter_rudder" />
                    <TextView
                        android:id="@+id/txt_value_counter_rudder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="2.0" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_counter_rudder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="10.0"
                    android:stepSize="0.5"
                    android:value="2.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_advanced_auto_trim" />
                    <TextView
                        android:id="@+id/txt_value_auto_trim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="0.10" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_auto_trim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:stepSize="0.01"
                    android:value="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_advanced_filter_sensitivity" />
                    <TextView
                        android:id="@+id/txt_value_filter_sensitivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="3" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_filter_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="10.0"
                    android:stepSize="1.0"
                    android:value="3.0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/nautical_advanced_response_preview"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="?attr/colorAccent"
                    android:textStyle="bold" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/pid_preview_chart"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="16dp"
                    android:background="?attr/activity_background_color" />
            </LinearLayout>

            <!-- Tab 2: Limits -->
            <LinearLayout
                android:id="@+id/container_limits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_advanced_rudder_limit" />
                    <TextView
                        android:id="@+id/txt_value_rudder_limit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="30°" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_rudder_limit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="10.0"
                    android:valueTo="45.0"
                    android:stepSize="1.0"
                    android:value="30.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_advanced_off_course_threshold" />
                    <TextView
                        android:id="@+id/txt_value_off_course"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="15°" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_off_course"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="5.0"
                    android:valueTo="30.0"
                    android:stepSize="1.0"
                    android:value="15.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_xte_threshold_desc" />
                    <TextView
                        android:id="@+id/txt_value_xte_threshold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="0.1 NM" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_xte_threshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.01"
                    android:valueTo="1.0"
                    android:stepSize="0.01"
                    android:value="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_actuator_alarm_threshold" />
                    <TextView
                        android:id="@+id/txt_value_actuator_threshold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="85%" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_actuator_threshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="50.0"
                    android:valueTo="95.0"
                    android:stepSize="1.0"
                    android:value="85.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_keel_offset_title" />
                    <TextView
                        android:id="@+id/txt_value_keel_offset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="0.0 m" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_keel_offset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="10.0"
                    android:stepSize="0.1"
                    android:value="0.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_wind_alignment_title" />
                    <TextView
                        android:id="@+id/txt_value_wind_alignment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="0°" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_wind_alignment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-180.0"
                    android:valueTo="180.0"
                    android:stepSize="1.0"
                    android:value="0.0" />
            </LinearLayout>

            <!-- Tab 3: Environment -->
            <LinearLayout
                android:id="@+id/container_env"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_sea_state" />
                    <TextView
                        android:id="@+id/txt_value_sea_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="3" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_auto_sea_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/nautical_auto"
                        android:textAppearance="?attr/textAppearanceCaption" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_sea_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1.0"
                    android:valueTo="5.0"
                    android:stepSize="1.0"
                    android:value="3.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_wave_bias_sensitivity" />
                    <TextView
                        android:id="@+id/txt_value_wave_bias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="50%" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_wave_bias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="100.0"
                    android:stepSize="10.0"
                    android:value="50.0" />
            </LinearLayout>

            <!-- Tab 4: Pypilot -->
            <LinearLayout
                android:id="@+id/container_pypilot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button android:id="@+id/btn_select_pypilot_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nautical_pypilot_profile" />

                <TextView style="@style/DashboardSubHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nautical_pypilot_pid" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_pypilot_p" />
                    <TextView
                        android:id="@+id/txt_value_p"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="0.0050" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/slider_p" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.0" android:valueTo="1.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_pypilot_i" />
                    <TextView
                        android:id="@+id/txt_value_i"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="0.0001" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/slider_i" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.0" android:valueTo="1.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_pypilot_d" />
                    <TextView
                        android:id="@+id/txt_value_d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="0.0100" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/slider_d" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.0" android:valueTo="1.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_pypilot_dd" />
                    <TextView
                        android:id="@+id/txt_value_dd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="0.0000" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/slider_dd" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.0" android:valueTo="1.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_pypilot_pr" />
                    <TextView
                        android:id="@+id/txt_value_pr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="1.00" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/slider_pr" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.0" android:valueTo="1.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_pypilot_ff" />
                    <TextView
                        android:id="@+id/txt_value_ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="0.00" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/slider_ff" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.0" android:valueTo="1.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_pypilot_wg" />
                    <TextView
                        android:id="@+id/txt_value_wg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="0.00" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/slider_wg" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.0" android:valueTo="1.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_pypilot_deadzone" />
                    <TextView
                        android:id="@+id/txt_value_deadzone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorAccent"
                        android:textStyle="bold"
                        tools:text="0.0°" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/slider_deadzone" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.0" android:valueTo="5.0" />

                <TextView style="@style/DashboardSubHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/nautical_pypilot_calibration" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_calibrate_compass" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/nautical_pypilot_calibrate_compass" />
                    <Button android:id="@+id/btn_stop_compass_calib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nautical_stop_calibration" />
                </LinearLayout>
                <ProgressBar android:id="@+id/progress_compass" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_calibrate_rudder" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/nautical_pypilot_calibrate_rudder" />
                    <Button android:id="@+id/btn_stop_rudder_calib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nautical_stop_calibration" />
                </LinearLayout>
                <ProgressBar android:id="@+id/progress_rudder" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_reset_defaults"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/nautical_advanced_reset_defaults"
                android:textColor="@color/text_color_negative" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">
        <Button
            android:id="@+id/btn_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nautical_advanced_cancel" />
        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
