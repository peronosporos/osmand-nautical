<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/divider_color"
    app:cardBackgroundColor="?attr/card_and_list_background_basic">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_leg_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Leg 1: WP 1 → WP 2"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/txt_leg_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.2 NM"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="?attr/active_color_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/txt_leg_cts_twa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CTS: 045°T • TWA: 52°"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/txt_leg_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wind: 14 kn @ 095°"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/txt_leg_depth_clearance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Depth: > 5.0 m (Safe)"
                android:textSize="12sp"
                android:textColor="@color/nautical_status_green" />

            <TextView
                android:id="@+id/txt_leg_tidal_drift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0.8 kn Current"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_nautical_chip"
                android:textColor="?attr/active_color_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_leg_ete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ETE: 38 min"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
