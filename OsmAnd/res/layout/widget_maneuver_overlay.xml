<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/maneuver_overlay_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#000000">

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nautical_maneuver_state_armed"
        android:textColor="#FFFF00"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/collision_alert_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nautical_collision_warning"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#FF0000"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/touch_lock_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nautical_touch_lock_active_msg"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#00FFFF"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/sail_plan_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nautical_sail_plan_no_data"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/heading_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nautical_hdg_no_data"
            android:textColor="#00FF00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/wind_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nautical_awa_no_data"
            android:textColor="#00FF00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/maneuver_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginBottom="16dp"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:progressTint="#00FF00"
        android:max="100"
        android:progress="0"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_execute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/maneuver_execute"
        android:textSize="32sp"
        android:textStyle="bold"
        android:backgroundTint="#00FF00"
        android:textColor="#000000" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/shared_string_done"
        android:textSize="32sp"
        android:textStyle="bold"
        android:backgroundTint="#00FF00"
        android:textColor="#000000"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/shared_string_cancel"
        android:textSize="20sp"
        android:textStyle="bold"
        android:backgroundTint="#FF0000"
        android:textColor="#000000" />

</LinearLayout>
