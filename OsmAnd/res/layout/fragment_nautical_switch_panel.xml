<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/DashboardSubHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:text="@string/nautical_digital_switching" />

    <LinearLayout
        android:id="@+id/layout_windlass_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="16dp">

        <TextView
            style="@style/DashboardSubHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nautical_windlass_control"
            android:textColor="?attr/colorError" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_windlass_down"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/nautical_windlass_down"
                app:icon="@drawable/ic_arrow_down"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_windlass_up"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/nautical_windlass_up"
                app:icon="@drawable/ic_action_arrow_up"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_windlass_guard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nautical_windlass_engine_guard"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_energy_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="16dp">

        <TextView
            style="@style/DashboardSubHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/nautical_energy_management" />

        <LinearLayout
            android:id="@+id/group_chargers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/group_inverters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_switches"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/txt_no_switches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:text="@string/nautical_no_switches"
        android:visibility="gone" />
</LinearLayout>
