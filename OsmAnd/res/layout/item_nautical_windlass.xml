<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txt_windlass_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nautical_windlass_title"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_windlass_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?android:attr/textColorSecondary" />

    <LinearLayout
        android:id="@+id/layout_windlass_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_windlass_down"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/nautical_windlass_down"
            app:icon="@drawable/ic_arrow_down"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_windlass_up"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/nautical_windlass_up"
            app:icon="@drawable/ic_action_arrow_up"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_windlass_guard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nautical_windlass_engine_guard"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

</LinearLayout>
