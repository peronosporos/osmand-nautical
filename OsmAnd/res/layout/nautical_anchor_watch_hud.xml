<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_hud_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/img_anchor_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/nautical_anchor_label"
        android:src="@drawable/ic_action_anchor"
        app:tint="?attr/text_color_primary_v2" />

    <TextView
        android:id="@+id/txt_anchor_radius"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/text_color_primary_v2"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/divider_anchor_hud"
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginHorizontal="8dp"
        android:background="?attr/divider_color" />

    <TextView
        android:id="@+id/txt_rode_deployed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?attr/text_color_primary_v2"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_adjust_scope"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:paddingHorizontal="6dp"
        android:text="@string/nautical_anchor_scope_label"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reset_anchor_pos"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:paddingHorizontal="6dp"
        android:text="@string/shared_string_reset"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_weigh_anchor"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:paddingHorizontal="6dp"
        android:text="@string/nautical_weighing_anchor_btn_weigh"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
