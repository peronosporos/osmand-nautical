<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="?attr/activity_background_color">

    <include layout="@layout/simple_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Expandable Route Hazard / Shallow Water Warning Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_route_hazard_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="?attr/color_alert"
            app:cardBackgroundColor="?attr/card_and_list_background_basic"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/layout_hazard_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Hazard Warning"
                        android:src="@drawable/ic_action_alert"
                        app:tint="?attr/color_alert" />

                    <TextView
                        android:id="@+id/txt_hazard_warning_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nautical_shallow_hazard_warning"
                        android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                        android:textColor="?attr/color_alert"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btn_expand_hazard"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Expand Hazard Details"
                        android:src="@drawable/ic_action_arrow_drop_down"
                        app:tint="?attr/icon_color_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_hazard_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nautical_shallow_hazard_desc"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="?android:attr/textColorSecondary" />

                <!-- Expandable Detail Container -->
                <LinearLayout
                    android:id="@+id/layout_hazard_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:background="?attr/list_background_color"
                    android:padding="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txt_hazard_details_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Critical sounding alert: Leg crosses depth area &lt; 2.5m near shallow water contours."
                        android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Summary Stats Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/divider_color"
            app:cardBackgroundColor="?attr/card_and_list_background_basic">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/summary_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_route_summary_title"
                    android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/total_distance"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                        android:textColor="?android:attr/textColorPrimary"
                        android:fontFeatureSettings="tnum"
                        tools:text="Total Dist: 14.2 NM" />

                    <TextView
                        android:id="@+id/total_time"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                        android:textColor="?attr/active_color_primary"
                        android:fontFeatureSettings="tnum"
                        android:textStyle="bold"
                        tools:text="Total ETE: 2.1 h" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_tacks_gybes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="Tacks: 3 • Gybes: 1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export_passage_plan"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:text="EXPORT PASSAGE PLAN"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_action_export"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Leg Breakdown Section Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Passage Legs Breakdown"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption"
            android:textColor="?android:attr/textColorSecondary"
            android:textStyle="bold" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layout_empty_plan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_action_sail_boat_dark"
                app:tint="?attr/active_color_primary"
                android:contentDescription="Route Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No Active Passage Plan"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Create a marine route to compute courses to steer, tidal current offsets, layline angles, and leg-by-leg passage schedules."
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_passage_plan"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Create Passage Plan / New Marine Route"
                app:icon="@drawable/ic_action_add_no_bg" />

        </LinearLayout>

        <!-- Legs RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/legs_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

    </LinearLayout>

</LinearLayout>
