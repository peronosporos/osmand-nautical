<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_side_widget_day"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_action_flag"
        app:tint="#00FF00"
        android:contentDescription="Start Line" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/start_dist_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dist to Line: -- m"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/start_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time to Burn: --s"
            android:textColor="#FF0000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/start_bias_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bias: --°"
        android:textColor="#00FFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginEnd="8dp"/>

    <Button
        android:id="@+id/btn_clear_line"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clear"
        android:textColor="#888888"
        android:textSize="12sp" />

</LinearLayout>
