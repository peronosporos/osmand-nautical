<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_cockpit_hud"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/divider_color"
    app:cardBackgroundColor="?attr/card_and_list_background_basic">

    <LinearLayout
        android:id="@+id/layout_cockpit_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Top Control Bar: Mode Selector, VHF Chip, Auto/Lock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_hud_mode"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_passage"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="@string/nautical_hud_tab_sail"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_motoring"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="@string/nautical_hud_tab_motor"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_anchor"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="@string/nautical_hud_tab_anchor"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- VHF Working Channel Chip -->
            <TextView
                android:id="@+id/chip_vhf_channel"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_active_light"
                android:backgroundTint="?attr/active_color_primary"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/nautical_vhf_16_label"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Auto/Lock Toggle Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lock_mode"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                app:icon="@drawable/ic_action_lock_open"
                app:iconSize="18dp"
                app:iconTint="?attr/icon_color_primary"
                android:contentDescription="Auto Mode Switch Lock" />

            <!-- Remote Web Display QR / Pairing Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_remote_qr"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                app:icon="@drawable/ic_action_qrcode"
                app:iconSize="18dp"
                app:iconTint="?attr/icon_color_primary"
                android:contentDescription="Remote Web Berth Display QR" />
        </LinearLayout>

        <!-- Mode 1: PASSAGE / SAILING STRIP -->
        <LinearLayout
            android:id="@+id/layout_mode_passage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_passage_sog_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- kn"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
                <TextView
                    android:id="@+id/txt_passage_cog_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COG: --°"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_passage_twa_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TWA --°"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/active_color_primary" />
                <TextView
                    android:id="@+id/txt_passage_tws_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TWS: -- kn"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_passage_vmg_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- %"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_polar_vmg_label"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_passage_xte_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XTE 0.00"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
                <TextView
                    android:id="@+id/txt_passage_layline_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_on_layline"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mode 2: MOTORING / HARBOR STRIP -->
        <LinearLayout
            android:id="@+id/layout_mode_motoring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_motor_sog_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- kn"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_harbor_sog_label"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_motor_rudder_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0° MID"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/active_color_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_rudder_arc_label"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_motor_depth_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- m"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
                <TextView
                    android:id="@+id/txt_motor_tide_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIDE: ▲ +0.0m"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_motor_hazard_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLEAR"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#43A047" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_fwd_hazard_label"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mode 3: ANCHOR / MOORED STRIP -->
        <LinearLayout
            android:id="@+id/layout_mode_anchor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_anchor_depth_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- m"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_depth_dbk_label"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_anchor_rode_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- m"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/active_color_primary" />
                <TextView
                    android:id="@+id/txt_anchor_scope_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCOPE: 5:1"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_anchor_radius_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- m"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_swing_radius_label"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_anchor_battery_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- %"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#43A047" />
                <TextView
                    android:id="@+id/txt_anchor_chafe_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_chafe_ok"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
