<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pilot_glass"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pilot_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/bottom_sheet_handle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_handle"
            android:backgroundTint="#99FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/shared_string_options" />

        <!-- 1. Dashboard Header (Mode Toggles + Settings) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/mode_toggle_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bottom_sheet_handle"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_compass"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_action_direction_compass"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="?attr/icon_color_primary"
                app:strokeColor="@color/nautical_toggle_stroke_color"
                app:backgroundTint="@color/nautical_toggle_bg_tint"
                android:contentDescription="@string/nautical_mode_compass" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_wind"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_action_wind"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="?attr/icon_color_primary"
                app:strokeColor="@color/nautical_toggle_stroke_color"
                app:backgroundTint="@color/nautical_toggle_bg_tint"
                android:contentDescription="@string/nautical_mode_wind" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_route"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_action_track_16"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="?attr/icon_color_primary"
                app:strokeColor="@color/nautical_toggle_stroke_color"
                app:backgroundTint="@color/nautical_toggle_bg_tint"
                android:contentDescription="@string/nautical_mode_track" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_stop"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_action_stop"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="?attr/icon_color_primary"
                app:strokeColor="@color/nautical_toggle_stroke_color"
                app:backgroundTint="@color/nautical_toggle_bg_tint"
                android:contentDescription="@string/nautical_mode_stop" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <ImageButton
            android:id="@+id/btn_advanced"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/shared_string_settings"
            app:layout_constraintBottom_toBottomOf="@id/mode_toggle_group"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/mode_toggle_group"
            app:srcCompat="@drawable/ic_action_settings"
            app:tint="?attr/icon_color_primary" />

        <!-- 2. Autopilot Head Card (Steering + Control Cluster) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/steering_card"
            style="@style/Widget.App.Material.SectionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#26FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mode_toggle_group">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp">

                <!-- Heading Error (Linear Scale) at the TOP -->
                <net.osmand.plus.plugins.nautical.ui.HeadingErrorLinearView
                    android:id="@+id/heading_error_linear"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Control Cluster Middle Row -->
                <net.osmand.plus.plugins.nautical.ui.HeadingArcView
                    android:id="@+id/heading_arc_view"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heading_error_linear"
                    android:contentDescription="@string/nautical_pilot_title"
                    android:focusable="true" />

                <!-- Left Controls (Vertical Column) -->
                <LinearLayout
                    android:id="@+id/left_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/heading_arc_view"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/heading_arc_view">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_minus_10"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="64dp"
                        android:layout_height="56dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="-10"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/active_color_primary"
                        app:strokeColor="?attr/active_color_primary"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_minus_1"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="-1"
                        android:textColor="?attr/active_color_primary"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="?attr/active_color_primary" />
                </LinearLayout>

                <!-- Right Controls (Vertical Column) -->
                <LinearLayout
                    android:id="@+id/right_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/heading_arc_view"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/heading_arc_view">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_plus_10"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="64dp"
                        android:layout_height="56dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="+10"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/active_color_primary"
                        app:strokeColor="?attr/active_color_primary"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_plus_1"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="+1"
                        android:textColor="?attr/active_color_primary"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="?attr/active_color_primary" />
                </LinearLayout>

                <net.osmand.plus.plugins.nautical.ui.RudderView
                    android:id="@+id/rudder_view"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heading_arc_view"
                    android:contentDescription="@string/nautical_rudder_angle"
                    android:focusable="true" />

                <!-- Sea State Slider -->
                <LinearLayout
                    android:id="@+id/sea_state_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/rudder_view"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nautical_sea_calm"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="?attr/text_color_secondary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/nautical_sea_state"
                                android:textAppearance="?attr/textAppearanceCaption"
                                android:textColor="?attr/colorAccent"
                                android:textStyle="bold" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switch_auto_sea_state"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:scaleX="0.8"
                                android:scaleY="0.8" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AUTO"
                                android:textAppearance="?attr/textAppearanceCaption"
                                android:textColor="?attr/text_color_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="@string/nautical_sea_heavy"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="?attr/text_color_secondary" />
                    </RelativeLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_sea_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1.0"
                        android:valueTo="5.0"
                        android:stepSize="1.0"
                        android:value="3.0"
                        app:thumbColor="?attr/colorAccent"
                        app:trackColorActive="?attr/colorAccent" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Telemetry Pane (3x2 Matrix) -->
        <LinearLayout
            android:id="@+id/telemetry_pane"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/steering_card">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Row 1, Col 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/img_icon_1_1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_action_speed"
                        app:tint="?attr/icon_color_primary"
                        tools:ignore="ContentDescription" />
                    <TextView
                        android:id="@+id/txt_label_1_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/text_color_secondary"
                        tools:text="SOG" />
                    <TextView
                        android:id="@+id/txt_value_1_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="?attr/text_color_primary_v2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="6.4 kn" />
                </LinearLayout>

                <!-- Row 1, Col 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/img_icon_1_2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_action_direction_arrow"
                        app:tint="?attr/icon_color_primary"
                        tools:ignore="ContentDescription" />
                    <TextView
                        android:id="@+id/txt_label_1_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/text_color_secondary"
                        tools:text="HDG ERR" />
                    <TextView
                        android:id="@+id/txt_value_1_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="?attr/text_color_primary_v2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="2.1°" />
                </LinearLayout>

                <!-- Row 1, Col 3 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/img_icon_1_3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_action_direction_compass"
                        app:tint="?attr/icon_color_primary"
                        tools:ignore="ContentDescription" />
                    <TextView
                        android:id="@+id/txt_label_1_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/text_color_secondary"
                        tools:text="TARGET" />
                    <TextView
                        android:id="@+id/txt_value_1_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="?attr/text_color_primary_v2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="245°" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Row 2, Col 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/img_icon_2_1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_action_speed"
                        app:tint="?attr/icon_color_primary"
                        tools:ignore="ContentDescription" />
                    <TextView
                        android:id="@+id/txt_label_2_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/text_color_secondary"
                        tools:text="STW" />
                    <TextView
                        android:id="@+id/txt_value_2_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="?attr/text_color_primary_v2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="6.2 kn" />
                </LinearLayout>

                <!-- Row 2, Col 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/img_icon_2_2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_action_direction_movement"
                        app:tint="?attr/icon_color_primary"
                        tools:ignore="ContentDescription" />
                    <TextView
                        android:id="@+id/txt_label_2_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/text_color_secondary"
                        tools:text="SET/DRFT" />
                    <TextView
                        android:id="@+id/txt_value_2_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="?attr/text_color_primary_v2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="240/0.2" />
                </LinearLayout>

                <!-- Row 2, Col 3 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/img_icon_2_3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_action_direction_arrow"
                        app:tint="?attr/icon_color_primary"
                        tools:ignore="ContentDescription" />
                    <TextView
                        android:id="@+id/txt_label_2_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/text_color_secondary"
                        tools:text="ROT" />
                    <TextView
                        android:id="@+id/txt_value_2_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="?attr/text_color_primary_v2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="0.5°/s" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Digital Switching Section -->
        <TextView
            android:id="@+id/switching_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:text="DIGITAL SWITCHING"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?attr/colorAccent"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/telemetry_pane" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/switches_recycler"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/switching_title"
            tools:listitem="@layout/item_nautical_switch" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
