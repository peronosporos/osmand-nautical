<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/list_background_color"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Centered Drag Handle Pill -->
        <View
            android:id="@+id/drag_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/divider_color" />

        <!-- Call Type Toggle: MAYDAY (Distress) vs PAN-PAN (Urgency) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_call_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_type_mayday"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="@string/nautical_vhf_mayday"
                android:textColor="@color/color_warning"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_type_pan_pan"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="@string/nautical_vhf_pan_pan"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_type_securite"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="@string/nautical_vhf_securite"
                android:textStyle="bold" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Nature of Distress Chips -->
        <TextView
            android:id="@+id/txt_nature_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nautical_vhf_nature_of_emergency"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textStyle="bold"
            android:textColor="?attr/colorAccent"
            android:layout_marginBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_distress_nature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sinking"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/nautical_emergency_sinking" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_fire"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_emergency_fire" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_grounding"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_emergency_grounding" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_collision"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_emergency_collision" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mob"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_emergency_mob" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_adrift"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_emergency_disabled" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_medical"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nautical_emergency_medical" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- POB (Persons On Board) Stepper Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txt_pob_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nautical_pob_label"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="?android:attr/textColorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pob_minus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="−"
                android:textSize="18sp"
                app:cornerRadius="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:contentDescription="@string/nautical_accessibility_minus" />

            <TextView
                android:id="@+id/txt_pob_count"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="4"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorAccent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pob_plus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="+"
                android:textSize="18sp"
                app:cornerRadius="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:contentDescription="@string/nautical_accessibility_plus" />
        </LinearLayout>

        <!-- Dynamic Read-Aloud Script Box -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="?attr/colorAccent"
            app:cardBackgroundColor="?attr/card_and_list_background_basic"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/txt_distress_script_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:lineSpacingExtra="4dp"
                android:typeface="monospace"
                android:textSize="13.5sp"
                android:textColor="?android:attr/textColorPrimary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Copy & Practice Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_distress_script"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/nautical_copy_script"
                app:icon="@drawable/ic_action_copy"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_speak_distress_script"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/nautical_speak_script"
                app:icon="@drawable/ic_action_volume_up"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
