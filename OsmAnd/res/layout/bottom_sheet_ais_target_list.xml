<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/list_background_color"
    android:fitsSystemWindows="true">

    <!-- Drag Handle Indicator -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="?attr/divider_color" />

    <!-- Title & Action Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nautical_ais_targets_title"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_action_cancel"
            app:tint="?attr/icon_color_primary"
            android:contentDescription="@string/shared_string_cancel" />
    </LinearLayout>

    <!-- AIS-MOB / EPIRB Emergency Alert Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_mob_emergency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/nautical_status_bg_emergency"
        app:strokeColor="@color/nautical_status_text_emergency"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txt_mob_emergency_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AIS-MOB ACTIVATED: Bearing 045° / Distance 0.8 NM"
                android:textColor="@color/nautical_status_text_emergency"
                android:textStyle="bold"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mob_set_sar_course"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="SET DIRECT SAR COURSE"
                android:textSize="12sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_action_start_navigation"
                app:backgroundTint="@color/nautical_status_text_emergency"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Search Filter Bar -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_search_ais"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/nautical_ais_search_hint"
        app:startIconDrawable="@drawable/ic_action_search_dark"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_search_ais"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="textCapCharacters" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Segmented Header Filter Bar: [ Threat Priority ] [ Nearest ] [ All (A-Z) ] -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_sort_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sort_threat"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:text="@string/nautical_threat_priority"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:icon="@drawable/ic_action_alert"
            app:iconSize="16dp"
            app:iconPadding="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sort_nearest"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:text="@string/nautical_nearest"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:icon="@drawable/ic_action_pin_location"
            app:iconSize="16dp"
            app:iconPadding="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sort_name"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:text="@string/nautical_all_az"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:icon="@drawable/ic_action_group_list"
            app:iconSize="16dp"
            app:iconPadding="4dp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Predictive Time-Horizon Horizon Scrub Slider (0 - 30 min) -->
    <LinearLayout
        android:id="@+id/layout_predictive_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/txt_predictive_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forward Horizon: Real-time (T +0m)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_predictive_horizon"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:valueFrom="0"
            android:valueTo="30"
            android:stepSize="1"
            android:value="0"
            app:thumbColor="?attr/active_color_primary"
            app:trackColorActive="?attr/active_color_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_vector_mode"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:text="MOTION VECTORS: TRUE"
            android:textSize="12sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_action_target_direction_on"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Content Container (Recycler or Empty State) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="220dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_targets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layout_empty_targets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_action_ais_object_visibility"
                app:tint="?attr/icon_color_secondary"
                android:contentDescription="@string/nautical_no_ais_targets" />

            <TextView
                android:id="@+id/txt_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/nautical_no_ais_targets"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/nautical_no_ais_targets_desc"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
