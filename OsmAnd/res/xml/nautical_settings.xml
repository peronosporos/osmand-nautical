<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:title="@string/nautical_plugin_name"
    tools:context="net.osmand.plus.plugins.nautical.NauticalSettingsFragment">

    <!-- Section 1: Display & Visibility -->

    <PreferenceCategory
        android:key="nautical_display_category"
        android:layout="@layout/preference_category_with_descr"
        android:title="@string/nautical_display_settings" />

    <net.osmand.plus.settings.preferences.ListPreferenceEx
        android:key="nautical_vessel_context"
        android:layout="@layout/preference_with_descr"
        android:title="@string/vessel_context_label"
        android:summary="@string/vessel_context_desc" />

    <net.osmand.plus.settings.preferences.ListPreferenceEx
        android:key="nautical_display_mode"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_display_mode"
        android:summary="@string/nautical_display_mode_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_heavy_weather_mode"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_heavy_weather_mode"
        android:summary="@string/nautical_heavy_weather_mode_desc" />

    <!-- Section 2: Enabled Modules (Gatekeeping) -->

    <PreferenceCategory
        android:key="nautical_modules_category"
        android:layout="@layout/preference_category_with_descr"
        android:title="@string/nautical_modules_title"
        android:summary="@string/nautical_modules_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_ais_enabled"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_module_ais_title"
        android:summary="@string/nautical_module_ais_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_radar_enabled"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_radar_enabled_title"
        android:summary="@string/nautical_radar_enabled_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_depth_profile_enabled"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_depth_profile_enabled_title"
        android:summary="@string/nautical_depth_profile_enabled_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_polar_overlay_enabled"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_polar_overlay_enabled_title"
        android:summary="@string/nautical_polar_overlay_enabled_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_cockpit_mode_strip_enabled"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_cockpit_mode_strip_enabled_title"
        android:summary="@string/nautical_cockpit_mode_strip_enabled_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_module_tides"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_module_tides_title"
        android:summary="@string/nautical_module_tides_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_module_grib"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_module_grib_title"
        android:summary="@string/nautical_module_grib_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_vhf_enabled"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_vhf_enabled_title"
        android:summary="@string/nautical_vhf_enabled_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_module_logbook"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_module_logbook_title"
        android:summary="@string/nautical_module_logbook_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_module_enc"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_module_enc_title"
        android:summary="@string/nautical_module_enc_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_module_raster"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_module_raster_title"
        android:summary="@string/nautical_module_raster_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_navtex_enabled"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_navtex_enabled_title"
        android:summary="@string/nautical_navtex_enabled_desc" />

    <!-- Detailed Module Configurations -->

    <Preference
        android:key="nautical_diagnostics"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_signalk_diagnostics_title"
        android:summary="@string/nautical_signalk_diagnostics_desc" />

    <Preference
        android:key="nautical_advanced_tuning"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_autopilot_signal_processing_title"
        android:summary="@string/nautical_advanced_tuning_desc" />

    <PreferenceCategory
        android:layout="@layout/preference_category_with_descr"
        android:title="@string/nautical_more_settings_title" />

    <Preference
        android:key="nautical_screen_vessel"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_screen_vessel_title"
        android:summary="@string/nautical_screen_vessel_desc" />

    <Preference
        android:key="nautical_screen_safety"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_screen_safety_title"
        android:summary="@string/nautical_screen_safety_desc" />

    <Preference
        android:key="nautical_screen_targets"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_screen_targets_title"
        android:summary="@string/nautical_screen_targets_desc" />

    <Preference
        android:key="nautical_screen_connection"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_screen_connection_title"
        android:summary="@string/nautical_screen_connection_desc" />

    <Preference
        android:key="nautical_screen_charts"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_screen_charts_title"
        android:summary="@string/nautical_screen_charts_desc" />

    <PreferenceCategory
        android:key="nautical_smart_category"
        android:layout="@layout/preference_category_with_descr"
        android:title="@string/nautical_smart_title"
        android:summary="@string/nautical_smart_desc_long">

        <Preference
            android:key="nautical_boat_ai"
            android:layout="@layout/preference_with_descr"
            android:title="@string/nautical_module_boat_ai_title"
            android:summary="@string/nautical_boat_ai_summary" />

        <Preference
            android:key="nautical_notifications"
            android:layout="@layout/preference_with_descr"
            android:title="@string/nautical_notifications_title"
            android:summary="@string/nautical_notifications_summary" />

        <Preference
            android:key="nautical_checklists"
            android:layout="@layout/preference_with_descr"
            android:title="@string/nautical_checklists_title"
            android:summary="@string/nautical_checklists_desc" />
    </PreferenceCategory>

    <!-- Section 8: Chart Overlays & Performance -->

    <PreferenceCategory
        android:key="nautical_chart_overlays_category"
        android:layout="@layout/preference_category_with_descr"
        android:title="@string/nautical_chart_overlays_category_title" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_show_dead_reckoning"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_show_dead_reckoning_title"
        android:summary="@string/nautical_show_dead_reckoning_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_show_isochrones"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_show_isochrones_title"
        android:summary="@string/nautical_show_isochrones_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_show_anchor_zone"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_show_anchor_zone_title"
        android:summary="@string/nautical_show_anchor_zone_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_show_polar_overlay"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_show_polar_overlay_title"
        android:summary="@string/nautical_show_polar_overlay_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_show_depth_profile"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_show_depth_profile_title"
        android:summary="@string/nautical_show_depth_profile_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_show_radar_overlay"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_show_radar_overlay_title"
        android:summary="@string/nautical_show_radar_overlay_desc" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_show_clearance_badges"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_show_clearance_badges_title"
        android:summary="@string/nautical_show_clearance_badges_desc" />

    <!-- Section 10: Cockpit Ergonomics & Wet Screen -->

    <PreferenceCategory
        android:key="nautical_cockpit_ergonomics_category"
        android:layout="@layout/preference_category_with_descr"
        android:title="@string/nautical_cockpit_ergonomics_category_title" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_wet_screen_volume_keys"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_wet_screen_volume_keys_title"
        android:summary="@string/nautical_wet_screen_volume_keys_desc" />

</PreferenceScreen>
