<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/nautical_screen_vessel_title">

    <!-- Section 4: Vessel Profile & Tuning -->

    <PreferenceCategory
        android:key="nautical_vessel_category"
        android:layout="@layout/preference_category_with_descr"
        android:title="@string/nautical_vessel_category_title" />

    <net.osmand.plus.settings.preferences.ListPreferenceEx
        android:key="nautical_vessel_type"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_vessel_type" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_multihull_shunting"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_multihull_shunting_title"
        android:summary="@string/nautical_shunt_desc" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_vessel_draft"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_vessel_draft"
        android:inputType="numberDecimal" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_keel_offset"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_keel_offset_title"
        android:summary="@string/nautical_keel_offset_desc"
        android:inputType="numberDecimal" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_wind_alignment"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_wind_transducer_alignment_title"
        android:summary="@string/nautical_wind_alignment_desc"
        android:inputType="numberSigned" />

    <net.osmand.plus.settings.preferences.ListPreferenceEx
        android:key="nautical_heading_reference"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_heading_reference" />

    <net.osmand.plus.settings.preferences.ListPreferenceEx
        android:key="nautical_ttw_mode"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_ttw_mode" />

    <!-- Autopilot Tuning Sub-section - MOVED TO ADVANCED -->

    <PreferenceCategory
        android:key="nautical_autopilot_tuning_category"
        android:title="@string/nautical_autopilot_tuning_category_title"
        android:layout="@layout/preference_category_with_descr">

        <net.osmand.plus.settings.preferences.ListPreferenceEx
            android:key="nautical_pilot_sea_state"
            android:layout="@layout/preference_with_descr"
            android:title="@string/nautical_pilot_sea_state_title"
            android:summary="@string/nautical_pilot_sea_state_desc" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="nautical_maneuver_category"
        android:layout="@layout/preference_category_with_descr"
        android:title="@string/nautical_maneuver_params"
        android:summary="@string/nautical_maneuver_params_desc" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_med_mooring_vessel_length"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_med_mooring_vessel_length"
        android:inputType="numberDecimal" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_med_mooring_scope"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_med_mooring_scope"
        android:inputType="numberDecimal" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_tacking_wind_limit"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_tacking_wind_limit"
        android:inputType="numberDecimal" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_mob_audio_interval"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_mob_audio_interval"
        android:inputType="number" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_arrival_radius"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_arrival_radius"
        android:inputType="numberDecimal" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_lock_touch_during_maneuvers"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_lock_touch_during_maneuvers"
        android:summary="@string/nautical_lock_touch_during_maneuvers_description" />

    <!-- Section 6: Sailing Performance -->

    <PreferenceCategory
        android:key="nautical_sailing_category"
        android:layout="@layout/preference_category_with_descr"
        android:title="@string/pref_sailing_performance_title" />

    <Preference
        android:key="sail_inventory"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_sail_inventory_title"
        android:summary="@string/sail_inventory_desc" />

    <Preference
        android:key="sailing_performance"
        android:layout="@layout/preference_with_descr"
        android:title="@string/sailing_performance_title"
        android:summary="@string/sailing_performance_desc" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_laylines_tack_angle"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_laylines_tack_angle"
        android:inputType="numberDecimal" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_leeway_coefficient"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_leeway_coefficient"
        android:inputType="numberDecimal" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_manual_leeway_angle"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_manual_leeway_angle"
        android:summary="@string/nautical_manual_leeway_angle_desc"
        android:inputType="numberDecimal" />

    <net.osmand.plus.settings.preferences.SwitchPreferenceEx
        android:key="nautical_predictive_steering"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_predictive_steering"
        android:summary="@string/nautical_predictive_steering_desc" />

    <net.osmand.plus.settings.preferences.ListPreferenceEx
        android:key="nautical_wave_bias_sensitivity"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_wave_bias_sensitivity"
        android:dependency="nautical_predictive_steering" />

    <net.osmand.plus.settings.preferences.EditTextPreferenceEx
        android:key="nautical_wave_nudge_threshold"
        android:layout="@layout/preference_with_descr"
        android:title="@string/nautical_wave_nudge_threshold"
        android:summary="@string/nautical_wave_nudge_threshold_desc"
        android:inputType="numberDecimal"
        android:dependency="nautical_predictive_steering" />

</PreferenceScreen>
